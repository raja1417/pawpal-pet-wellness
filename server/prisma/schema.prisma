generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  pets         Pet[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Pet {
  id           String            @id @default(uuid())
  name         String
  species      String
  breed        String?
  birthdate    DateTime?
  weight       Float?
  photoUrl     String?
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  wellness     WellnessEntry[]
  vaccinations Vaccination[]
  vetVisits    VetVisit[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId])
}

model WellnessEntry {
  id              String   @id @default(uuid())
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  weight          Float?
  activityMinutes Int?
  mood            String?
  notes           String?
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([petId, recordedAt])
}

model Vaccination {
  id          String    @id @default(uuid())
  petId       String
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  name        String
  administeredAt DateTime?
  dueDate     DateTime
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([petId, dueDate])
}

model VetVisit {
  id        String   @id @default(uuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  reason    String
  visitDate DateTime
  notes     String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId, visitDate])
}
